# Inside the elioo-web image. Security headers and TLS live in the shared edge Caddy (~/n8n/Caddyfile).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	respond /healthz "ok" 200
	redir /tanvir https://tanvir.eliooo.org 308

	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@video path /video/*
	header @video Cache-Control "public, max-age=604800"
	@pages not path /_astro/* /video/*
	header @pages Cache-Control "public, max-age=300"

	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
