---
import type { Product } from '../data/products';
import { tryUrl } from '../data/products';
import StatusLabel from './StatusLabel.astro';
import VideoSlot from './VideoSlot.astro';
import { findVideo } from '../lib/video';

interface Props { product: Product }
const { product: p } = Astro.props;
const url = tryUrl(p);
---
<header class={`e-card e-card--${p.theme} e-product-header`}>
  <div class="e-card__copy">
    <div class="e-card__top">
      <p class="e-card__cat">{p.num} · {p.category}</p>
      <StatusLabel live={p.live} />
    </div>
    <h1 class="sr-only">{p.name}</h1>
    {p.logo.kind === 'image'
      ? <img class="e-card__logo e-product-header__logo" src={p.logo.src} alt="" aria-hidden="true" />
      : <span class="e-wordmark-drugs e-card__logo e-product-header__logo" aria-hidden="true">IntelliDrugs<b>.</b></span>}
    <p class="e-card__pitch">{p.pitch}</p>
    <div class="e-card__actions">
      {url && <a class="e-btn e-btn--try" href={url} target="_blank" rel="noopener">Try it <span class="e-arrow" aria-hidden="true">↗</span></a>}
    </div>
  </div>
  <div class="e-card__media">
    <VideoSlot theme={p.theme} label={`A short film of ${p.name}`} video={p.video ?? findVideo(p.slug)} placeholder={p.placeholder} />
  </div>
  <p class="e-card__num" aria-hidden="true">{p.num}</p>
</header>

<style is:global>
  .e-product-header { margin-top: var(--s-5); min-height: 520px; }
  .e-product-header__logo { height: 64px; }
  .e-product-header__logo.e-wordmark-drugs { height: auto; font-size: 64px; }
</style>
