---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPublishedEntries, toSummary, type PostEntry } from '../../lib/posts';

export async function getStaticPaths() {
  const entries = await getPublishedEntries();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1], next: entries[i + 1] },
  }));
}
interface Props { entry: PostEntry; prev?: PostEntry; next?: PostEntry }
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---
<Post post={toSummary(entry)} cover={entry.data.cover} prev={prev && toSummary(prev)} next={next && toSummary(next)}>
  <Content />
</Post>
